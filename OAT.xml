                <filteritem type="filename" name=".npmignore" desc="配置文件"/>
                <filteritem type="filename" name=".gitignore" desc="配置文件"/>
                <filteritem type="filename" name=".eslintrc.js" desc="配置文件"/>
                <filteritem type="filename" name=".eslintignore" desc="配置文件"/>
                <filteritem type="filename" name=".watchmanconfig" desc="配置文件"/>
                
                <filteritem type="filepath" name="src/.*" desc="第三方源码"/>
                <filteritem type="filepath" name="*.js" desc="第三方源码"/>
                <filteritem type="filepath" name="*.ts" desc="第三方源码"/>
                <filteritem type="filepath" name="*.ets" desc="第三方源码"/>
