                <filteritem type="filepath" name="harmony/selectable_text/src/main/cpp/generated/.*" desc="RNOH自动生成代码"/>
                <filteritem type="filepath" name="harmony/selectable_text/src/main/ets/generated/.*" desc="RNOH自动生成代码"/>

                <filteritem type="filename" name="*.json5" desc="配置文件"/>
                <filteritem type="filename" name="*/*.json5" desc="配置文件"/>
                <filteritem type="filename" name="LICENSE" desc="版权文件"/>
                <filteritem type="filename" name="CODEOWNERS" desc="版权文件"/>
                <filteritem type="filename" name="*.config.js" desc="工程配置文件"/>
                <filteritem type="filename" name=".prettierrc.js" desc="工程配置文件"/>
                <filteritem type="filename" name=".prettierignore" desc="工程配置文件"/>
                <filteritem type="filename" name="*.yaml" desc="工程配置文件"/>
